# Phoebe tenant secrets for mikeallisonJS/stemlab. Copy to `.env` (gitignored) and fill in.
#
# A fine-grained PAT for mikeallisonJS/stemlab only: Contents, Pull requests and Issues
# read/write, Actions read (Metadata read is automatic).
GH_TOKEN=
# The provider key named by providerEnv.claude in phoebe.config.ts.
ANTHROPIC_AUTH_TOKEN=
