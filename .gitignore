# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
dist/
dist-electron/
build/
release/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/
venv_*/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS specific
.DS_Store
Thumbs.db

# Tools
.pytest_cache/
.ruff_cache/

# Audio is never committed, apart from the test fixtures
*.mp3
*.wav
*.flac
*.ogg
*.m4a
*.aac
!tests/fixtures/*.flac

# Real tracks for local testing
tests/local/

# Model weights never enter git
*.ckpt
*.th
*.onnx
*.pth

# UI
app/node_modules/
app/dist/
app/out/
app/release/
.env
.wrangler/
