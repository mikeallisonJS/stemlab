{
  "name": "captainstems-app",
  "private": true,
  "version": "2.0.0-dev.0",
  "description": "CaptainStems UI: recipe editor, run queue and results",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:main": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs --loader:.html=text",
    "desktop": "pnpm build:main && electron .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wavesurfer.js": "^7.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
