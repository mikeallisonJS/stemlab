{
  "name": "stemlab-app",
  "private": true,
  "version": "1.0.0",
  "description": "Stemlab UI: recipe editor, run queue and results",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:main": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs --loader:.html=text",
    "desktop": "pnpm build:main && electron .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json",
    "test": "vitest run",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "icons": "node scripts/build-icons.mjs",
    "dist": "pnpm build && pnpm build:main && pnpm prepare:engine && electron-builder --config electron-builder.cjs --publish never"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wavesurfer.js": "^7.12.0"
  }
}
